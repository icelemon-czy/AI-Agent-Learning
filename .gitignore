neo4j_data/
neo4j_logs/
neo4j_plugins/
qdrant_storage/

# --- Application Data ---
# 忽略本地生成的知识库、日志或临时文件
knowledge_base/
*.log
output/

# --- Build & Distribution ---
build/
dist/
*.egg-info/
